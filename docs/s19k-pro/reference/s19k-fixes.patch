diff --git a/mujina-miner/src/board/psu_bitbang_i2c.rs b/mujina-miner/src/board/psu_bitbang_i2c.rs
new file mode 100644
index 0000000..f337f16
--- /dev/null
+++ b/mujina-miner/src/board/psu_bitbang_i2c.rs
@@ -0,0 +1,177 @@
+//! Synchronous bit-banged I2C over two sysfs GPIO lines, used only for
+//! this specific unit's PSU bus (GPIO 476/477, labelled `I2C_SCL`/
+//! `I2C_SDA` in Bitmain's own `/etc/init.d/S37board_setup`).
+//!
+//! On this hardware/firmware combination the PSU is not reachable via
+//! any real `/dev/i2c-N` character device (confirmed empirically --
+//! `LinuxI2cDevice::open("/dev/i2c-1", 0x10)` fails with ENXIO). This
+//! is a drop-in synchronous transport with the same two primitives
+//! `NativeAmlogicPsu::exchange` needs (`write_byte_transaction`,
+//! `read_byte_transaction`), so only the transport is swapped -- the
+//! real PSU protocol framing (`build_frame`/`parse_frame`/CMD_*) is
+//! untouched.
+
+use std::fs;
+use std::thread::sleep;
+use std::time::Duration;
+
+const HALF_PERIOD: Duration = Duration::from_micros(50);
+
+pub struct BitBangI2cDevice {
+    scl: u32,
+    sda: u32,
+    address: u8,
+}
+
+impl BitBangI2cDevice {
+    pub fn open(scl: u32, sda: u32, address: u16) -> anyhow::Result<Self> {
+        export(scl)?;
+        export(sda)?;
+        let dev = Self {
+            scl,
+            sda,
+            address: address as u8,
+        };
+        dev.release(scl)?;
+        dev.release(sda)?;
+        delay();
+        Ok(dev)
+    }
+
+    /// SMBus "write byte data": START, addr+W, register, byte, STOP.
+    pub fn write_byte_transaction(&mut self, register: u8, byte: u8) -> anyhow::Result<()> {
+        self.start()?;
+        let result = (|| -> anyhow::Result<()> {
+            self.require_ack(self.write_byte(self.address << 1)?)?;
+            self.require_ack(self.write_byte(register)?)?;
+            self.require_ack(self.write_byte(byte)?)?;
+            Ok(())
+        })();
+        self.stop()?;
+        result
+    }
+
+    /// SMBus "receive byte": START, addr+R, read one byte (NAKed), STOP.
+    pub fn read_byte_transaction(&mut self) -> anyhow::Result<u8> {
+        self.start()?;
+        let result = (|| -> anyhow::Result<u8> {
+            self.require_ack(self.write_byte((self.address << 1) | 1)?)?;
+            let mut byte = 0u8;
+            for _ in 0..8 {
+                byte = (byte << 1) | u8::from(self.read_bit()?);
+            }
+            self.write_bit(true)?; // NAK: no more bytes wanted
+            Ok(byte)
+        })();
+        self.stop()?;
+        result
+    }
+
+    fn require_ack(&self, acked: bool) -> anyhow::Result<()> {
+        if acked {
+            Ok(())
+        } else {
+            Err(anyhow::anyhow!(
+                "bit-banged I2C: no ACK from address 0x{:02X}",
+                self.address
+            ))
+        }
+    }
+
+    fn start(&self) -> anyhow::Result<()> {
+        self.release(self.sda)?;
+        self.release(self.scl)?;
+        delay();
+        self.drive_low(self.sda)?;
+        delay();
+        self.drive_low(self.scl)?;
+        delay();
+        Ok(())
+    }
+
+    fn stop(&self) -> anyhow::Result<()> {
+        self.drive_low(self.sda)?;
+        delay();
+        self.release(self.scl)?;
+        delay();
+        self.release(self.sda)?;
+        delay();
+        Ok(())
+    }
+
+    fn write_byte(&self, byte: u8) -> anyhow::Result<bool> {
+        for i in (0..8).rev() {
+            self.write_bit((byte >> i) & 1 != 0)?;
+        }
+        let nak = self.read_bit()?;
+        Ok(!nak)
+    }
+
+    fn write_bit(&self, high: bool) -> anyhow::Result<()> {
+        if high {
+            self.release(self.sda)?;
+        } else {
+            self.drive_low(self.sda)?;
+        }
+        delay();
+        self.release(self.scl)?;
+        delay();
+        self.drive_low(self.scl)?;
+        delay();
+        Ok(())
+    }
+
+    fn read_bit(&self) -> anyhow::Result<bool> {
+        self.release(self.sda)?;
+        delay();
+        self.release(self.scl)?;
+        delay();
+        let bit = get_value(self.sda)?;
+        self.drive_low(self.scl)?;
+        delay();
+        Ok(bit)
+    }
+
+    fn release(&self, gpio: u32) -> anyhow::Result<()> {
+        set_direction(gpio, "in")
+    }
+
+    fn drive_low(&self, gpio: u32) -> anyhow::Result<()> {
+        set_direction(gpio, "out")?;
+        set_value(gpio, false)
+    }
+}
+
+fn delay() {
+    sleep(HALF_PERIOD);
+}
+
+fn gpio_path(gpio: u32, leaf: &str) -> String {
+    format!("/sys/class/gpio/gpio{gpio}/{leaf}")
+}
+
+fn export(gpio: u32) -> anyhow::Result<()> {
+    if fs::metadata(format!("/sys/class/gpio/gpio{gpio}")).is_ok() {
+        return Ok(());
+    }
+    match fs::write("/sys/class/gpio/export", gpio.to_string()) {
+        Ok(()) => Ok(()),
+        Err(e) if e.raw_os_error() == Some(16) => Ok(()), // EBUSY: already exported
+        Err(e) => Err(e.into()),
+    }
+}
+
+fn set_direction(gpio: u32, dir: &str) -> anyhow::Result<()> {
+    fs::write(gpio_path(gpio, "direction"), dir)?;
+    Ok(())
+}
+
+fn set_value(gpio: u32, high: bool) -> anyhow::Result<()> {
+    fs::write(gpio_path(gpio, "value"), if high { "1" } else { "0" })?;
+    Ok(())
+}
+
+fn get_value(gpio: u32) -> anyhow::Result<bool> {
+    let s = fs::read_to_string(gpio_path(gpio, "value"))?;
+    Ok(s.trim() == "1")
+}
